DebugLibraryName=
Prefix=

[Platform.MacARM]
Enabled=1
LibraryName=libwebview.dylib
DebugLibraryName=
Prefix=

[Platform.MacIntel]
Enabled=1
LibraryName=libwebview.dylib
DebugLibraryName=
Prefix=

[Platform.Linux64]
Enabled=1
LibraryName=libwebview.so
DebugLibraryName=
Prefix=

[Platform.iOS]
Enabled=0
LibraryName=
DebugLibraryName=
Prefix=

[Platform.Android32]
Enabled=0
LibraryName=
DebugLibraryName=
Prefix=

[Platform.Android64]
Enabled=0
LibraryName=
DebugLibraryName=
Prefix=

[ParseOptions]
IgnoreParseErrors=0
CmdLineArgs=

[ConvertOptions]
CallConv=Cdecl
CharConvert=AnsiChar
UnsignedCharConvert=Byte
CommentConvert=Remove
ReservedWordHandling=PrefixAmpersand
TreatDirectivesAsReservedWords=1
DelayedLoading=0
