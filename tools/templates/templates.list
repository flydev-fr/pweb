# The trusted CAP-10B0 template list.
#
# This file is the BUILD INPUT that decides what pweb-templates.zip contains
# and what a project made from it looks like. It is never shipped, never read
# at runtime, and never consulted by the CLI: the pack builder turns it into
# a generated native registry, and that registry - not this file and not the
# archive - is what the runtime believes.
#
# EVERY FILE IS DECLARED EXPLICITLY, with its output path, its content kind
# and its file mode. Nothing is inferred from an extension, because the two
# mistakes that matter in this class - substituting inside a binary, and
# shipping a credential - are exactly the ones an extension rule gets wrong.
# The builder cross-checks this list against the directory in BOTH
# directions: a file on disk that nobody declared is an error, and a
# declared file that is not on disk is an error.
#
# The source path on the left is LITERAL. The `out` path on the right may
# carry placeholders. Keeping the two apart is what lets a template ship
# `gitignore` and generate `.gitignore` without a dot-file inside this
# repository quietly changing what git tracks here.
#
# Grammar: `key = value`, one per line, '#' comments, blank lines ignored,
# ASCII only, no escape sequence anywhere. `template` opens a block and
# `file` opens a file block inside it. Every key is required and an unknown
# key is a hard error.

schema = 1

# ---------------------------------------------------------------------------
# fixture - the PRIVATE neutral template CAP-10B0 tests the engine with.
#
# It is not React and it is not Pas2JS: CAP-10B0 freezes the scaffolding
# ENGINE and deliberately ships no runnable public template, so a fixture is
# the honest thing to exercise it with. visibility = private keeps it
# unreachable from any public command even once one exists, and CAP-10B1 will
# add the react template beside it rather than replacing it.
#
# It is chosen to exercise every branch the engine has: text with
# placeholders, text without, a placeholder in an output PATH, a dot-file
# rename, nested directories, a byte-exact binary carrying all 256 byte
# values, and one file with an intended POSIX executable mode.
# ---------------------------------------------------------------------------

template = fixture
  visibility = private
  ui = react
  native-dir = src
  native-ext = lpr
  frontend-root = frontend
  output-dir = dist

  file = README.md
    out = README.md
    content = text
    mode = normal

  file = gitignore
    out = .gitignore
    content = text
    mode = normal

  file = gitattributes
    out = .gitattributes
    content = text
    mode = normal

  file = src/program.lpr
    out = src/{{PASCAL_PROGRAM}}.lpr
    content = text
    mode = normal

  file = frontend/index.html
    out = frontend/index.html
    content = text
    mode = normal

  file = frontend/app.js
    out = frontend/app.js
    content = text
    mode = normal

  file = assets/bytes.bin
    out = assets/bytes.bin
    content = binary
    mode = normal

  file = tools/check.sh
    out = tools/check.sh
    content = text
    mode = executable

# ---------------------------------------------------------------------------
# react - the PUBLIC template `pweb create NAME --ui react` produces.
#
# It is a complete, buildable application and not a demonstration of one: a
# real mORMot service, the production CAP-8 capability policy, a real React
# 18 frontend built by Vite, and the exact lockfile that pins it. What it
# deliberately does NOT contain is any part of PWeb itself - no runtime, no
# mORMot, no webview binding, no platform adapter and no TypeScript SDK -
# because a generated project holds application sources and resolves the
# framework from the SDK installation that created it.
#
# The frontend's @pweb/runtime dependency is a project-relative `file:`
# specifier pointing at .pweb/sdk/typescript, which a build materialises
# from the trusted SDK root into its staging area. That is why the path is
# relative, why it is in the generated .gitignore, and why `npm ci` in a
# freshly created project is not a supported step on its own.
#
# EVERY file here is text: strict UTF-8, LF only, exactly one final newline,
# and no doubled opening brace except the placeholder tokens themselves.
# ---------------------------------------------------------------------------

template = react
  visibility = public
  ui = react
  native-dir = src
  native-ext = lpr
  frontend-root = frontend
  output-dir = dist

  file = README.md
    out = README.md
    content = text
    mode = normal

  file = gitignore
    out = .gitignore
    content = text
    mode = normal

  file = gitattributes
    out = .gitattributes
    content = text
    mode = normal

  file = src/program.lpr
    out = src/{{PASCAL_PROGRAM}}.lpr
    content = text
    mode = normal

  file = src/app.services.pas
    out = src/app.services.pas
    content = text
    mode = normal

  file = frontend/index.html
    out = frontend/index.html
    content = text
    mode = normal

  file = frontend/package.json
    out = frontend/package.json
    content = text
    mode = normal

  file = frontend/package-lock.json
    out = frontend/package-lock.json
    content = text
    mode = normal

  file = frontend/tsconfig.json
    out = frontend/tsconfig.json
    content = text
    mode = normal

  file = frontend/vite.config.ts
    out = frontend/vite.config.ts
    content = text
    mode = normal

  file = frontend/src/main.tsx
    out = frontend/src/main.tsx
    content = text
    mode = normal

  file = frontend/src/App.tsx
    out = frontend/src/App.tsx
    content = text
    mode = normal

  file = frontend/src/app.css
    out = frontend/src/app.css
    content = text
    mode = normal

  file = frontend/src/vite-env.d.ts
    out = frontend/src/vite-env.d.ts
    content = text
    mode = normal

# ---------------------------------------------------------------------------
# pas2js - the PUBLIC template `pweb create NAME --ui pas2js` produces.
#
# The SAME application as the react template, with the frontend written in
# Object Pascal and compiled to browser JavaScript by the pinned Pas2JS 3.0.1
# through the frozen pweb.native SDK. Its NATIVE half is not "like" the react
# one: src/app.services.pas is byte-identical to it, and src/program.lpr
# differs only inside its header comment, which test/cap10b2 measures on every
# CI leg. There is one generated application architecture, and the frontend
# kind is build content rather than runtime behaviour.
#
# What it deliberately does NOT contain, beyond the react template's list: any
# Node or npm metadata. A Pas2JS project has no package.json, no lockfile and
# no node_modules, and `pweb doctor` requires none of them for it - so nothing
# here exists merely to look like the other template.
#
# The PWeb Pas2JS SDK unit is NOT here either. It is resolved at build time
# from the PWeb installation, which is why frontend/pas2js.cfg carries the
# portable compile options and no unit path at all.
#
# EVERY file here is text: strict UTF-8, LF only, exactly one final newline,
# and no doubled opening brace except the placeholder tokens themselves.
# ---------------------------------------------------------------------------

template = pas2js
  visibility = public
  ui = pas2js
  native-dir = src
  native-ext = lpr
  frontend-root = frontend
  output-dir = dist

  file = README.md
    out = README.md
    content = text
    mode = normal

  file = gitignore
    out = .gitignore
    content = text
    mode = normal

  file = gitattributes
    out = .gitattributes
    content = text
    mode = normal

  file = src/program.lpr
    out = src/{{PASCAL_PROGRAM}}.lpr
    content = text
    mode = normal

  file = src/app.services.pas
    out = src/app.services.pas
    content = text
    mode = normal

  file = frontend/index.html
    out = frontend/index.html
    content = text
    mode = normal

  file = frontend/app.css
    out = frontend/app.css
    content = text
    mode = normal

  file = frontend/pas2js.cfg
    out = frontend/pas2js.cfg
    content = text
    mode = normal

  file = frontend/src/program.lpr
    out = frontend/src/{{PASCAL_PROGRAM}}app.lpr
    content = text
    mode = normal

  file = frontend/src/app.pas
    out = frontend/src/app.pas
    content = text
    mode = normal
