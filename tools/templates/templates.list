# The trusted CAP-10B0 template list.
#
# This file is the BUILD INPUT that decides what pweb-templates.zip contains
# and what a project made from it looks like. It is never shipped, never read
# at runtime, and never consulted by the CLI: the pack builder turns it into
# a generated native registry, and that registry - not this file and not the
# archive - is what the runtime believes.
#
# EVERY FILE IS DECLARED EXPLICITLY, with its output path, its content kind
# and its file mode. Nothing is inferred from an extension, because the two
# mistakes that matter in this class - substituting inside a binary, and
# shipping a credential - are exactly the ones an extension rule gets wrong.
# The builder cross-checks this list against the directory in BOTH
# directions: a file on disk that nobody declared is an error, and a
# declared file that is not on disk is an error.
#
# The source path on the left is LITERAL. The `out` path on the right may
# carry placeholders. Keeping the two apart is what lets a template ship
# `gitignore` and generate `.gitignore` without a dot-file inside this
# repository quietly changing what git tracks here.
#
# Grammar: `key = value`, one per line, '#' comments, blank lines ignored,
# ASCII only, no escape sequence anywhere. `template` opens a block and
# `file` opens a file block inside it. Every key is required and an unknown
# key is a hard error.

schema = 1

# ---------------------------------------------------------------------------
# fixture - the PRIVATE neutral template CAP-10B0 tests the engine with.
#
# It is not React and it is not Pas2JS: CAP-10B0 freezes the scaffolding
# ENGINE and deliberately ships no runnable public template, so a fixture is
# the honest thing to exercise it with. visibility = private keeps it
# unreachable from any public command even once one exists, and CAP-10B1 will
# add the react template beside it rather than replacing it.
#
# It is chosen to exercise every branch the engine has: text with
# placeholders, text without, a placeholder in an output PATH, a dot-file
# rename, nested directories, a byte-exact binary carrying all 256 byte
# values, and one file with an intended POSIX executable mode.
# ---------------------------------------------------------------------------

template = fixture
  visibility = private
  ui = react
  native-dir = src
  native-ext = lpr
  frontend-root = frontend
  output-dir = dist

  file = README.md
    out = README.md
    content = text
    mode = normal

  file = gitignore
    out = .gitignore
    content = text
    mode = normal

  file = gitattributes
    out = .gitattributes
    content = text
    mode = normal

  file = src/program.lpr
    out = src/{{PASCAL_PROGRAM}}.lpr
    content = text
    mode = normal

  file = frontend/index.html
    out = frontend/index.html
    content = text
    mode = normal

  file = frontend/app.js
    out = frontend/app.js
    content = text
    mode = normal

  file = assets/bytes.bin
    out = assets/bytes.bin
    content = binary
    mode = normal

  file = tools/check.sh
    out = tools/check.sh
    content = text
    mode = executable
