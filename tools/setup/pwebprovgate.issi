; Shared PWeb provisioning-gate include (CAP-6b2 anti-fork extraction
; of the ratified CAP-6b1 normal.iss body). Both PROVISIONING install
; profiles - tools/setup/normal.iss (Evergreen Bootstrapper, CAP-6b1)
; and tools/setup/offline.iss (Evergreen Standalone Installer,
; CAP-6b2) - consume this one file, so the embedded-payload model, the
; define validation and the fail-closed provisioning gate can never
; fork between them. The application identity itself moved one level
; down at CAP-6b3, into tools/setup/pwebappsetup.issi, which the
; non-provisioning fixed profile (tools/setup/fixed.iss) consumes as
; well; this file includes it below. The ONLY difference between the
; two provisioning profiles is the neutral define each .iss maps
; before including this file:
;
;   PWEB_WV2_INSTALLER    filename of the lock-verified installer this
;                         profile embeds (normal.iss maps its existing
;                         PWEB_WV2_BOOTSTRAPPER define; offline.iss
;                         maps PWEB_WV2_STANDALONE)
;
; Everything else is derived by the profile build scripts from the
; ratified locks at BUILD time (see the CAP-6b1 header convention):
;   PWEB_PAYLOAD_DIR      staged payload directory (release triple +
;                         lock-verified installer + compiled helper)
;   PWEB_WV2_SHA256       ratified lock digest (64 lowercase hex)
;   PWEB_WV2_SUBJECT      ratified Authenticode leaf subject
;   PWEB_WV2_TIMEOUT_MS   bounded helper wait, parsed by the build
;                         script from PWEB_WV2_INSTALL_TIMEOUT_MS in
;                         pweb.platform.webview2.provision.pas - the
;                         Pascal constant is the single source, never
;                         a literal duplicated here
;   PWEB_PROV_HELPER      TEST HOOK (optional; default pwebwv2prov.exe):
;                         filename of the provisioning helper inside
;                         PWEB_PAYLOAD_DIR. Production builds leave it
;                         at the default; the abort-probe TEST build
;                         overrides it with an always-fail stub to
;                         prove, by automation, that a helper failure
;                         aborts the setup with nothing installed.
;                         Nothing else may ever override it.
;
; Provisioning runs in PrepareToInstall through the COMPILED Pascal
; helper pwebwv2prov.exe (reusing the frozen CAP-6b0 policy functions;
; never re-implemented in PascalScript): detect -> verify (SHA-256 +
; Authenticode) -> bounded silent execute -> mandatory re-probe. A
; nonzero helper exit aborts the setup BEFORE any file is installed,
; so no launchable app can remain on a machine whose runtime could not
; be proven usable. The runtime may end up per-machine through the
; documented Microsoft auto-promotion - that is NOT a failure; the
; acceptance is a per-user app install plus a usable post-provision
; detector verdict.
;
; There is deliberately NO Launch entry and no [Run] section: setup
; either completes with a proven-usable runtime or aborts fail-closed.
; Nothing in this file (or in any profile consuming it) can reach the
; network: the embedded payload is the only installer source, and the
; lock URLs are build metadata that never appear here.

#ifndef PWEB_WV2_INSTALLER
  #error PWEB_WV2_INSTALLER must be mapped by the including profile (.iss) before this include
#endif
#ifndef PWEB_PAYLOAD_DIR
  #error PWEB_PAYLOAD_DIR must be defined - build via the profile build script (test/cap6b1/build_normal_setup.ps1 or test/cap6b2/build_offline_setup.ps1)
#endif
#ifndef PWEB_WV2_SHA256
  #error PWEB_WV2_SHA256 must be defined - build via the profile build script (test/cap6b1/build_normal_setup.ps1 or test/cap6b2/build_offline_setup.ps1)
#endif
#ifndef PWEB_WV2_SUBJECT
  #error PWEB_WV2_SUBJECT must be defined - build via the profile build script (test/cap6b1/build_normal_setup.ps1 or test/cap6b2/build_offline_setup.ps1)
#endif
#ifndef PWEB_WV2_TIMEOUT_MS
  #error PWEB_WV2_TIMEOUT_MS must be defined - build via the profile build script (test/cap6b1/build_normal_setup.ps1 or test/cap6b2/build_offline_setup.ps1)
#endif
#ifndef PWEB_PROV_HELPER
  #define PWEB_PROV_HELPER "pwebwv2prov.exe"
#endif

; the neutral half - [Setup] identity (AppId, per-user location,
; PrivilegesRequired=lowest, architecture gating, compression) and the
; CAP-6b4 profile marker - lives in the shared include below, which the
; CAP-6b3 fixed profile consumes too (CAP-6b3 anti-fork extraction).
; Nothing about the installed application identity is authored in this
; provisioning-only file any more.
#include "pwebappsetup.issi"

[Files]
; provisioning payload: extracted to {tmp} on demand, auto-deleted by
; Inno when setup exits (success OR abort) - never installed to {app}
Source: "{#PWEB_PAYLOAD_DIR}\{#PWEB_WV2_INSTALLER}"; Flags: dontcopy
Source: "{#PWEB_PAYLOAD_DIR}\{#PWEB_PROV_HELPER}"; Flags: dontcopy

; the unchanged CAP-6 release triple, authored once in the shared
; payload include. An Evergreen profile has no post-install gate, so
; its position is free; it sits after the dontcopy payload above purely
; for readability.
#include "pwebapppayload.issi"

[InstallDelete]
; CAP-6b4 STALE-TREE RECLAIM. All three profiles are modes of ONE
; product sharing one AppId and one install directory, so installing an
; Evergreen profile over a CAP-6b3 fixed one used to strand the ~690 MB
; bundled runtime tree forever: the Evergreen-mode binary never looks
; at it, and the uninstaller of the newer install only removes what
; that install recorded.
;
; This one entry is the whole fix, and it is Inno's own machinery -
; there is no DelTree, no RegDeleteKey and no hand-rolled cleanup
; anywhere in this repository's setups (CAP-6b3 measured hand-rolled
; deletion racing the installer into an incidental EFileError).
;
; ORDER IS THE SAFETY PROPERTY, and it is Inno's, not ours:
; PrepareToInstall runs BEFORE the installation phase, and
; [InstallDelete] is the FIRST step of that phase. So on a
; fixed -> Evergreen switch the frozen gate below has already PROVEN a
; usable Evergreen runtime by the time a single byte of the old tree is
; touched; a refusal aborts with zero file operations and the fixed
; install stays exactly as it was, tree included.
;
; THE MEASURED RESIDUAL, stated rather than implied. [InstallDelete] is
; NOT part of Inno's rollback: once the tree is reclaimed it stays
; reclaimed, so a failure LATER in this same run leaves a stale
; `fixed-runtime` marker on a machine whose tree is already gone. That
; is untidy, and it is not dangerous, for one measured reason: Inno's
; rollback does not restore OVERWRITTEN files (measured with the pinned
; ISCC 6.7.3 - it was the whole reason the fixed profile's [Files] order
; changed), so the Evergreen-mode release triple this run had already
; copied survives, and PrepareToInstall had already proven an Evergreen
; runtime usable. The app therefore still runs; only the marker lies,
; and the next install of any profile corrects it. Inno offers no
; post-[Registry] failure seam, and hand-rolled cleanup is exactly what
; CAP-6b3 measured to be harmful.
;
; OWNERSHIP IS CHECKED, because {app} is user-redirectable. On an
; interactive run the user can point setup at any directory; without a
; check, a directory that merely happened to contain runtime\webview2
; would have it recursively deleted by an installer that never put it
; there. PWebOwnsInstallDir below therefore lets the reclaim proceed
; only when this is an over-install of OUR product.
;
; It targets only the runtime subdirectory this product installs (and
; the intermediate directory that subdirectory lives in), named from the
; single PWEB_RUNTIME_SUBDIR / PWEB_RUNTIME_PARENT sources in
; pwebappsetup.issi - never {app} itself, and never any user data. The
; WebView2 user-data folder (%APPDATA%\releaseapp.exe) is SHARED across
; profiles and deliberately untouched here and at uninstall.
;
; The parent entry comes SECOND on purpose: [InstallDelete] entries are
; processed in order, so the leaf has to be gone before dirifempty can
; find the parent empty.
Type: filesandordirs; Name: "{app}\{#PWEB_RUNTIME_SUBDIR}"; \
    Check: PWebOwnsInstallDir
Type: dirifempty; Name: "{app}\{#PWEB_RUNTIME_PARENT}"; \
    Check: PWebOwnsInstallDir

[Code]
// The stale-tree reclaim's ownership gate. {app} is user-redirectable
// on an interactive run, so "there is a runtime\webview2 under {app}"
// is NOT on its own a licence to delete it recursively - the directory
// may belong to something this installer never touched.
//
// The signal used is the presence of OUR OWN Inno uninstaller in {app},
// which means one specific thing: a previous install of this product
// put its files here. It is read at [InstallDelete] time, which is
// BEFORE this run writes anything (this run's own uninstaller is
// written later, during the [Files] phase), so the file it sees can
// only be a pre-existing one.
//
// Deliberately NOT the profile marker: the marker is per-USER and says
// nothing about which DIRECTORY setup was pointed at, and the very
// install this reclaim exists to migrate - a pre-CAP-6b4 fixed install
// - predates the marker and carries none.
function PWebOwnsInstallDir: Boolean;
var
  Dir: String;
begin
  Dir := ExpandConstant('{app}');
  Result := FileExists(AddBackslash(Dir) + 'unins000.exe');
  if Result then
    Log('PWEB_RECLAIM owned install detected in ' + Dir +
      ' - the stale runtime tree (if any) will be reclaimed')
  else
    Log('PWEB_RECLAIM no PWeb uninstaller in ' + Dir +
      ' - reclaim SKIPPED (this directory is not an over-install of our product)');
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Helper, Installer, ProvLog, Params: String;
  Output: AnsiString;
  Rc: Integer;
begin
  Result := '';
  ExtractTemporaryFile('{#PWEB_PROV_HELPER}');
  ExtractTemporaryFile('{#PWEB_WV2_INSTALLER}');
  Helper := ExpandConstant('{tmp}\{#PWEB_PROV_HELPER}');
  Installer := ExpandConstant('{tmp}\{#PWEB_WV2_INSTALLER}');
  ProvLog := ExpandConstant('{tmp}\pwebwv2prov.log');
  Params := '"' + Installer + '" {#PWEB_WV2_SHA256} "{#PWEB_WV2_SUBJECT}" ' +
    '{#PWEB_WV2_TIMEOUT_MS} "' + ProvLog + '"';
  Log('PWEB_WV2PROV launching: ' + Helper + ' ' + Params);
  if not Exec(Helper, Params, ExpandConstant('{tmp}'), SW_HIDE,
       ewWaitUntilTerminated, Rc) then
  begin
    Log('PWEB_WV2PROV exec-failed');
    Result := 'The WebView2 provisioning helper could not be started. ' +
      'Setup cannot continue and nothing was installed.';
    exit;
  end;
  if LoadStringFromFile(ProvLog, Output) then
    Log('PWEB_WV2PROV output:' + #13#10 + Output)
  else
    Log('PWEB_WV2PROV output file missing');
  Log('PWEB_WV2PROV exit=' + IntToStr(Rc));
  if Rc <> 0 then
    // fail closed: the helper's re-probe verdict is authoritative and
    // aborting here leaves NO installed launchable app behind
    Result := 'WebView2 runtime provisioning failed (helper exit ' +
      IntToStr(Rc) + '). Setup cannot continue and nothing was installed.';
end;
